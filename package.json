{
  "name": "spike",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:server": "turbo run build --filter=...server",
    "build:landing": "turbo run build --filter=landing",
    "dev:landing": "turbo run dev --filter=landing",
    "docker:server": "docker build -f apps/server/Dockerfile -t spike-server .",
    "eas-build-post-install": "pnpm --filter @spike/shared build"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.5",
    "@tanstack/react-query": "^5.107.1",
    "axios": "^1.21.1",
    "expo-constants": "^58.0.16",
    "expo-crypto": "^58.0.8",
    "expo-device": "^58.0.5",
    "expo-secure-store": "^58.0.3",
    "react-hook-form": "^7.92.0",
    "react-native-toastify-expo": "^1.3.0",
    "tailwindcss": "^4.3.5",
    "uniwind": "^1.13.2",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  }
}