{
  "name": "spike",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "node init && turbo run dev",
    "build": "node init && turbo run build",
    "build:server": "node init && turbo run build --filter=...server",
    "build:landing": "node init && turbo run build --filter=landing",
    "dev:landing": "node init && turbo run dev --filter=landing",
    "docker:server": "docker build -f apps/server/Dockerfile -t spike-server ."
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.5",
    "@tanstack/react-query": "^5.107.1",
    "axios": "^1.21.1",
    "react-hook-form": "^7.92.0",
    "tailwindcss": "^4.3.5",
    "uniwind": "^1.13.2",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  }
}
